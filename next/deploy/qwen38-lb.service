[Unit]
Description=Qwen3.8 Flash-Next OpenAI API on port 8080
After=network-online.target qwen38-flashnext-optimized-262k.service
Wants=network-online.target

[Service]
Type=simple
User=douya
WorkingDirectory=/home/douya
ExecStart=/usr/bin/python3 /home/douya/qwen-3.8-next/proxy.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
StandardOutput=append:/home/douya/qwen-3.8-next/logs/proxy.log
StandardError=append:/home/douya/qwen-3.8-next/logs/proxy.log

[Install]
WantedBy=multi-user.target
