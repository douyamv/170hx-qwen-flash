+// Runtime switches under $NEXT_OPT_DIR, re-checked at most once per second.
+static bool next_opt_file_exists(const char * name, std::chrono::steady_clock::time_point & next_check, bool & cached) {
+    const auto now = std::chrono::steady_clock::now();
+    if (now >= next_check) {
+        next_check = now + std::chrono::seconds(1);
+        const char * dir = getenv("NEXT_OPT_DIR");
+        struct stat st;
+        cached = dir != nullptr && stat((std::string(dir) + "/" + name).c_str(), &st) == 0;
+    }
+    return cached;
+}
+
+static bool next_mmq_grid_enabled() {
+    static std::chrono::steady_clock::time_point next_check{};
+    static bool off = false;
+    return !next_opt_file_exists("mmq_grid_off", next_check, off);
+}
+
+static bool next_mmq_stats_enabled() {
+    static std::chrono::steady_clock::time_point next_check{};
+    static bool on = false;
+    return next_opt_file_exists("mmq_stats", next_check, on);
+}
